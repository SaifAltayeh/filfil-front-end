# Public site URL used for metadata, sitemap, and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional public contact details. Leave empty until official values are supplied.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_TIKTOK_URL=

# Optional Google Maps embed URL. If empty, the site uses a search embed
# for "FILFIL Sweifieh Village Amman Jordan".
NEXT_PUBLIC_MAPS_EMBED_URL=

# Optional email delivery via Resend. Without these, submissions are stored locally.
RESEND_API_KEY=
CONTACT_INBOX_EMAIL=

# Optional Supabase (database + private CV storage). Without these, submissions
# are written to data/submissions and data/uploads on the local filesystem.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_CAREERS_BUCKET=careers
